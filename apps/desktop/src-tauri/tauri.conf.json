{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linvo Desktop",
  "version": "0.1.6",
  "identifier": "com.linvo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Linvo Desktop",
        "label": "main",
        "width": 440,
        "height": 620,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "title": "Linvo Desktop",
        "label": "panel",
        "width": 1200,
        "height": 800,
        "visible": false,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "title": "Checklist",
        "label": "checklist",
        "width": 288,
        "height": 420,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      },
      {
        "title": "Captura",
        "label": "capture-overlay",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "center": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' https://fonts.gstatic.com",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3001 ws://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' https://fonts.gstatic.com",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RjY0RTlFRkU2MDA1NUUKUldSZUJXRCtuazcycCtzWnYzRTFTYWQ3aEpqMXc4dDBRZFhFN0t3UHpqMEFaZFladnRqd0UwMG4K",
      "endpoints": [
        "https://github.com/RenanMev/linvo-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
